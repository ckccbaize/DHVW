{
  "schema_version": 1,
  "note": "已注册 act 词表（§14.7）：生成器与模型只能在这里选，不得新增 id。effects/requires 只能用 §14.3/§14.4 的枚举。",
  "acts": {
    "sleep": {
      "label": "睡觉",
      "trigger": { "props": ["bed"] },
      "requires": [{ "kind": "time", "between": ["22:00", "07:00"] }],
      "perform": { "animation": "sleep", "duration_min": 480, "interruptible": true },
      "effects": [
        { "kind": "mood", "target": "energy", "delta": 1.0, "apply": "on_complete" },
        { "kind": "mood", "target": "energy", "delta": 0.5, "apply": "on_interrupt" },
        { "kind": "advance_time", "minutes": 480 },
        { "kind": "event", "name": "sleep" }
      ],
      "priority": 10,
      "bubble": "睡一会儿。",
      "tags": ["quiet", "night"]
    },
    "lie_down": {
      "label": "躺一下",
      "trigger": { "props": ["bed"] },
      "perform": { "animation": "rest", "duration_min": 20, "interruptible": true },
      "effects": [
        { "kind": "mood", "target": "energy", "delta": 0.1, "apply": "on_complete" },
        { "kind": "event", "name": "lie_down" }
      ],
      "priority": 3,
      "tags": ["quiet"]
    },
    "watch_tv": {
      "label": "看电视",
      "trigger": { "props": ["tv"] },
      "perform": { "animation": "watch_tv", "duration_min": 45, "interruptible": true },
