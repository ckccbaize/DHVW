        { "kind": "mood", "target": "valence", "delta": 0.12, "apply": "on_complete" },
        { "kind": "event", "name": "watch_tv" }
      ],
      "priority": 6,
      "bubble": "看会儿电视。",
      "tags": ["quiet", "leisure"]
    },
