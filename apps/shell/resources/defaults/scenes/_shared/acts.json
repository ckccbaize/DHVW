        { "kind": "mood", "target": "valence", "delta": 0.05, "apply": "on_complete" },
        { "kind": "event", "name": "sit_sofa" }
      ],
      "priority": 4,
      "tags": ["quiet", "leisure"]
    },
    "rest_armchair": {
      "label": "瘫一会儿",
      "trigger": { "props": ["armchair", "fountain"] },
