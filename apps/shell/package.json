{
  "name": "dhvw-shell",
  "version": "0.1.0",
  "private": true,
  "description": "DHVW 主机端外壳（Electron 45）",
  "author": "DHVW",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "setup": "node scripts/install.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && node scripts/pack.mjs",
    "pack": "node scripts/pack.mjs",
    "audit:layout": "node scripts/layout-audit.mjs"
  },
  "dependencies": {
    "node-forge": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.7"
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
