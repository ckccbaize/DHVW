[Unit]
Description=DHVW device shell (read-only static server on 127.0.0.1:8080)
Documentation=https://github.com/../arm/docs/DEVICE-DESIGN.md
After=network.target
Before=dhvw-kiosk.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/dhvw-shell -addr 127.0.0.1:8080 -root /opt/dhvw/www
Restart=always
RestartSec=2
MemoryMax=64M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/dhvw/www
# 只读壳不该写盘：日志走 journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
