[Unit]
Description=DHVW kiosk (Chromium fullscreen on 127.0.0.1:8080)
After=dhvw-shell.service dhvw-x.service
Requires=dhvw-shell.service dhvw-x.service

[Service]
Type=simple
User=dhvw
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/dhvw/.Xauthority
Environment=LANG=zh_CN.UTF-8
Environment=LANGUAGE=zh_CN:zh
ExecStartPre=/usr/bin/curl -sf --max-time 5 http://127.0.0.1:8080/__health
ExecStart=/opt/dhvw/kiosk.sh
Restart=always
RestartSec=3
# 浏览器崩溃/白屏自动重启；内存上限留给总观 + 显现
MemoryMax=1400M
OOMScoreAdjust=-200
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical.target
