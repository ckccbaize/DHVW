[Unit]
Description=DHVW display keep-awake (X screen saver/DPMS off) + resolution watchdog
After=dhvw-x.service
Requires=dhvw-x.service

[Service]
Type=simple
Environment=DISPLAY=:0
# 常亮 + 分辨率看门狗，逻辑见 /opt/dhvw/display-watchdog.sh：
#  1) 屏保与 DPMS 三个 timeout 全部归零，并把 fbcon blank 压回 0。
#  2) X 拿不到 DRM master 时 xrandr 报 "Configure crtc 0 failed" 并停在
#     320x200，且不会自愈；连续 3 次读到宽度 < 1280 就重启 dhvw-x。
ExecStart=/opt/dhvw/display-watchdog.sh
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
